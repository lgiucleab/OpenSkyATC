<Application x:Class="OpenSkyAtc.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:OpenSkyAtc.App"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <app:BoolToVisibility x:Key="Visible" />
        <app:BoolToVisibility x:Key="Collapsed" Invert="True" />
        <!-- Rounded buttons (owner's request, radius as in the design): panels holding buttons put this in their resources as
             ControlCornerRadius, which the Fluent button template reads. -->
        <CornerRadius x:Key="PillRadius">8</CornerRadius>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Application.Resources>
</Application>
