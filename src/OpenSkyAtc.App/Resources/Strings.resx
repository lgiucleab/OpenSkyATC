    <value>3. Your first flight</value>
  </data>
  <data name="Welcome.Fly1" xml:space="preserve">
    <value>1. In MSFS, load your flight at a gate or parking spot of the plan's departure airport.</value>
  </data>
  <data name="Welcome.Fly2" xml:space="preserve">
