<Window x:Class="OpenSkyAtc.App.Views.CompactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:OpenSkyAtc.App"
        Title="OpenSkyATC" Width="420" Height="230" MinWidth="320" MinHeight="160"
        Topmost="True" ShowInTaskbar="True" WindowStyle="ToolWindow">
    <DockPanel Margin="10,8">
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="{Binding [Main.Expand], Source={x:Static app:Loc.Instance}}" Click="Expand_Click" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Frequency}" FontSize="20" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TalkingTo}" Margin="10,0,0,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource Badge}" Margin="10,0,0,0" VerticalAlignment="Center" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        Visibility="{Binding PushToTalk, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding [Status.Ptt], Source={x:Static app:Loc.Instance}}" FontSize="12" />
                </Border>
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Hint}" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                   Visibility="{Binding Hint, Converter={StaticResource Visible}}" Margin="0,4,0,0" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding LastAtc}" TextWrapping="Wrap" Margin="0,6,0,6" MaxHeight="60" TextTrimming="CharacterEllipsis" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Intents}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Command="{Binding Command}" CommandParameter="{Binding}" Padding="10,5" MaxWidth="380" Margin="0,0,6,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Primary}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Danger}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
