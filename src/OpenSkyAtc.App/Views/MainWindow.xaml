<Window x:Class="OpenSkyAtc.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:OpenSkyAtc.App"
        xmlns:vm="clr-namespace:OpenSkyAtc.App.ViewModels"
        Title="OpenSkyATC" Width="880" Height="760" MinWidth="680" MinHeight="560"
        Topmost="{Binding AlwaysOnTop}">
    <!-- Main window (refactor phase 5, owner's reference layout): header, conversation with filters, clearance tiles,
         then your calls, the switches and the radio. -->
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.InfoBg}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Info}" />
        </Style>
        <Style x:Key="FilterButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <app:EnumMatches x:Key="EnumMatches" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: logo, flight, sim link, always on top, start/end -->
        <DockPanel Grid.Row="0" Margin="4,0,4,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <StaticResource x:Key="ControlCornerRadius" ResourceKey="PillRadius" />
                </StackPanel.Resources>
                <Border CornerRadius="12" Padding="10,3" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="{Binding StatusDetail}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Connected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=(TextElement.Foreground)}"
                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StatusText}" />
                    </StackPanel>
                </Border>
                <CheckBox Content="{Binding [Main.AlwaysOnTop], Source={x:Static app:Loc.Instance}}" IsChecked="{Binding AlwaysOnTop}"
                          VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Command="{Binding ImportPlanCommand}" Padding="14,6" Style="{DynamicResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE709;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding [Main.StartFlight], Source={x:Static app:Loc.Instance}}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/logo.png" Width="28" Height="28" Margin="0,0,10,0"
                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="OpenSkyATC" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{Binding FlightLine}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <!-- Hint: tune, release the brake... -->
        <Border Grid.Row="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                Visibility="{Binding Hint, Converter={StaticResource Visible}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Brush.InfoBg}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Info}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HintIsWarning}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.CautionBg}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Caution}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Hint}" FontSize="14" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Conversation -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,10,12,4">
                    <StackPanel.Resources>
                        <StaticResource x:Key="ControlCornerRadius" ResourceKey="PillRadius" />
                    </StackPanel.Resources>
                    <RadioButton Style="{StaticResource FilterButton}" Content="{Binding [Main.FilterAll], Source={x:Static app:Loc.Instance}}"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumMatches}, ConverterParameter={x:Static vm:TranscriptFilter.All}, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:TranscriptFilter.All}" />
                    <RadioButton Style="{StaticResource FilterButton}" Content="{Binding [Main.FilterAtc], Source={x:Static app:Loc.Instance}}"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumMatches}, ConverterParameter={x:Static vm:TranscriptFilter.Atc}, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:TranscriptFilter.Atc}" />
                    <RadioButton Style="{StaticResource FilterButton}" Content="{Binding [Main.FilterYou], Source={x:Static app:Loc.Instance}}"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumMatches}, ConverterParameter={x:Static vm:TranscriptFilter.Pilot}, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:TranscriptFilter.Pilot}" />
                    <RadioButton Style="{StaticResource FilterButton}" Content="{Binding [Main.FilterEvents], Source={x:Static app:Loc.Instance}}"
                                 IsChecked="{Binding Filter, Converter={StaticResource EnumMatches}, ConverterParameter={x:Static vm:TranscriptFilter.Events}, Mode=OneWay}"
                                 Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:TranscriptFilter.Events}" />
                </StackPanel>
                <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" Padding="12,4,12,10">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"
                                   HorizontalAlignment="Center" Visibility="{Binding ShowStatusDetail, Converter={StaticResource Visible}}" />
                        <ItemsControl ItemsSource="{Binding TranscriptView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TranscriptLine}">
                                    <Grid Margin="0,4">
                                        <!-- ATC: right, with the tower; you: left, with the pilot; events: centred, small -->
                                        <DockPanel x:Name="Bubble" HorizontalAlignment="Left" MaxWidth="620" Visibility="Collapsed">
                                            <TextBlock x:Name="Icon" DockPanel.Dock="Left" Text="&#xE77B;" FontFamily="{StaticResource Icons}" FontSize="18"
                                                       VerticalAlignment="Top" Margin="0,6,8,0" Foreground="{DynamicResource Brush.Pilot}" />
                                            <Border x:Name="Body" CornerRadius="10" Padding="12,7" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <StackPanel>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <Run Text="{Binding Who, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text="{Binding Time, Mode=OneWay}" />
                                                        <Run x:Name="AutoMark" Text="" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Text}" FontSize="15" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock x:Name="EventLine" HorizontalAlignment="Center" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding Time, Mode=OneWay}" />
                                            <Run Text="{Binding Text, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPilot}" Value="True">
                                            <Setter TargetName="Bubble" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAtc}" Value="True">
                                            <Setter TargetName="Bubble" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                            <Setter TargetName="Icon" Property="DockPanel.Dock" Value="Right" />
                                            <Setter TargetName="Icon" Property="Text" Value="&#xEC05;" />
                                            <Setter TargetName="Icon" Property="Margin" Value="8,6,0,0" />
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Atc}" />
                                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Brush.InfoBg}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Auto}" Value="True">
                                            <Setter TargetName="AutoMark" Property="Text" Value="· auto" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEvent}" Value="True">
                                            <Setter TargetName="EventLine" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                            <Setter TargetName="EventLine" Property="Foreground" Value="{DynamicResource Brush.Caution}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Clearance tiles -->
        <UniformGrid Grid.Row="3" Columns="6" Margin="-4,10,-4,10">
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TileLabel}" Text="{Binding [Tile.Runway], Source={x:Static app:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding TileRunway}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TileLabel}" Text="{Binding [Tile.Route], Source={x:Static app:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding TileRoute}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TileLabel}" Text="{Binding [Tile.Cleared], Source={x:Static app:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding TileCleared}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TileLabel}" Text="{Binding [Tile.Squawk], Source={x:Static app:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding TileSquawk}" />
                </StackPanel>
            </Border>
            <Border ToolTip="{Binding TileNextName}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Tile}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HintIsWarning}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.CautionBg}" />
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Caution}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource TileLabel}" Text="{Binding [Tile.Next], Source={x:Static app:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding TileNext}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Style="{StaticResource TileLabel}" Text="{Binding [Tile.Atis], Source={x:Static app:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource TileValue}" Text="{Binding TileAtis}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Your calls | switches | radio -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="6,2,6,4" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{Binding [Main.Requests], Source={x:Static app:Loc.Instance}, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · " />
                        <Run Text="{Binding [Main.KeysHint], Source={x:Static app:Loc.Instance}, Mode=OneWay}" />
                    </TextBlock>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="170">
                        <ItemsControl ItemsSource="{Binding Intents}">
                            <ItemsControl.Resources>
                                <StaticResource x:Key="ControlCornerRadius" ResourceKey="PillRadius" />
                            </ItemsControl.Resources>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:IntentButton}">
                                    <Button x:Name="Call" Command="{Binding Command}" CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left" Padding="10,7" Margin="0,2">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Number}" Width="18" Opacity="0.6" />
                                            <TextBlock x:Name="Label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Primary}" Value="True">
                                            <Setter TargetName="Call" Property="Style" Value="{DynamicResource AccentButtonStyle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Danger}" Value="True">
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Critical}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,8,0">
                <StackPanel VerticalAlignment="Center">
                    <CheckBox Content="{Binding [Main.AutoRespond], Source={x:Static app:Loc.Instance}}" IsChecked="{Binding AutoRespond}" Margin="0,2"
                              ToolTip="{Binding [Main.AutoRespondHelp], Source={x:Static app:Loc.Instance}}" />
                    <CheckBox Content="{Binding [Main.AutoTune], Source={x:Static app:Loc.Instance}}" IsChecked="{Binding AutoTune}" Margin="0,2"
                              ToolTip="{Binding [Main.AutoTuneHelp], Source={x:Static app:Loc.Instance}}" />
                    <CheckBox Content="{Binding [Main.TaxiArrows], Source={x:Static app:Loc.Instance}}" IsChecked="{Binding TaxiArrows}" Margin="0,2" />
                    <CheckBox Content="{Binding [Main.HardModeShort], Source={x:Static app:Loc.Instance}}" IsChecked="{Binding HardMode}" Margin="0,2"
                              ToolTip="{Binding [Main.HardMode], Source={x:Static app:Loc.Instance}}" />
                    <Border CornerRadius="12" Padding="10,3" Margin="0,6,0,0" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PushToTalk}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.CautionBg}" />
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Caution}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding PttText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ComLabel}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Frequency}" FontSize="26" FontWeight="SemiBold" FontFamily="Consolas, Segoe UI" />
                        <TextBlock Text="⇄" Margin="10,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding Standby, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding Standby}" FontSize="15" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding StationLine}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer: notices, then the tools -->
        <DockPanel Grid.Row="5" Margin="4,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <StackPanel.Resources>
                    <StaticResource x:Key="ControlCornerRadius" ResourceKey="PillRadius" />
                </StackPanel.Resources>
                <Button Style="{StaticResource FooterButton}" Command="{Binding EndFlightCommand}" IsEnabled="{Binding FlightActive}"
                        ToolTip="{Binding [Main.EndFlight], Source={x:Static app:Loc.Instance}}">
                    <TextBlock Text="&#xE71A;" FontFamily="{StaticResource Icons}" FontSize="15" />
                </Button>
                <Button Style="{StaticResource FooterButton}" Click="PastFlights_Click" ToolTip="{Binding [Main.PastFlights], Source={x:Static app:Loc.Instance}}">
                    <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Icons}" FontSize="15" />
                </Button>
                <Button Style="{StaticResource FooterButton}" Click="FlightLogs_Click" ToolTip="{Binding [Main.FlightLogs], Source={x:Static app:Loc.Instance}}">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="15" />
                </Button>
                <Button Style="{StaticResource FooterButton}" Click="GettingStarted_Click" ToolTip="{Binding [Main.GettingStarted], Source={x:Static app:Loc.Instance}}">
                    <TextBlock Text="&#xE897;" FontFamily="{StaticResource Icons}" FontSize="15" />
                </Button>
                <Button Style="{StaticResource FooterButton}" Click="Settings_Click" ToolTip="{Binding [Main.Settings], Source={x:Static app:Loc.Instance}}">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="15" />
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource Brush.Caution}" TextWrapping="Wrap"
                           Visibility="{Binding Notice, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding ArrowsText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                           Visibility="{Binding ArrowsText, Converter={StaticResource Visible}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
