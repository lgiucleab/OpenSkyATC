<Window x:Class="OpenSkyAtc.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:OpenSkyAtc.App"
        xmlns:host="clr-namespace:OpenSkyAtc.Host;assembly=OpenSkyAtc.Host"
        Title="OpenSkyATC" Width="780" Height="640" MinWidth="600" MinHeight="460">
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Field" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="CallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="Margin" Value="0,0,10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
    </Window.Resources>

    <Border Margin="16" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <DockPanel>
            <!-- Header: name, sim and push-to-talk state, import, menu -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Section}" Padding="18,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <StackPanel.Resources>
                            <StaticResource x:Key="ControlCornerRadius" ResourceKey="PillRadius" />
                        </StackPanel.Resources>
                        <Button Command="{Binding ImportPlanCommand}" Padding="16,7" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B5;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding [Main.ImportPlan], Source={x:Static app:Loc.Instance}}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="MenuButton" Click="Menu_Click" Padding="12,7" ToolTip="{Binding [Main.Settings], Source={x:Static app:Loc.Instance}}">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="15" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding [Main.Settings], Source={x:Static app:Loc.Instance}}" Click="Settings_Click" />
                                    <MenuItem Header="{Binding [Main.Compact], Source={x:Static app:Loc.Instance}}" Click="Compact_Click" />
                                    <MenuItem Header="{Binding [Main.PastFlights], Source={x:Static app:Loc.Instance}}" Click="PastFlights_Click" />
                                    <MenuItem Header="{Binding [Main.FlightLogs], Source={x:Static app:Loc.Instance}}" Click="FlightLogs_Click" />
                                    <Separator />
                                    <MenuItem Header="{Binding [Main.EndFlight], Source={x:Static app:Loc.Instance}}" Command="{Binding EndFlightCommand}"
                                              IsEnabled="{Binding FlightActive}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="OpenSkyATC" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <Border ToolTip="{Binding StatusDetail}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Connected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.SuccessBg}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE703;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding StatusText}" />
                            </StackPanel>
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.InfoBg}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Info}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PushToTalk}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.CautionBg}" />
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Caution}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE720;" FontFamily="{StaticResource Icons}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding PttText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Flight strip -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Section}" Padding="18,12">
                <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Field}" Text="{Binding [Main.Callsign], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Callsign}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Field}" Text="{Binding [Main.Route], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Route}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource Field}" Text="{Binding [Main.Phase], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Phase}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Field}" Text="{Binding [Main.Cleared], Source={x:Static app:Loc.Instance}}" />
                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Cleared}" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Radio: what COM1 is on, and the next thing to tune -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Section}" Padding="18,12">
                <DockPanel>
                    <Border DockPanel.Dock="Left" CornerRadius="8" Padding="14,10" MinWidth="200" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Field}" Text="{Binding [Main.TalkingTo], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Text="{Binding Frequency}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding TalkingTo}" FontSize="15" />
                        </StackPanel>
                    </Border>
                    <Border Margin="14,0,0,0" CornerRadius="8" Padding="14,10" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.CautionBg}"
                            Visibility="{Binding HintIsWarning, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Brush.Caution}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource Brush.Caution}" FontSize="15" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Pilot calls -->
            <Border DockPanel.Dock="Bottom" Padding="18,14,18,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Intents}">
                        <ItemsControl.Resources>
                            <StaticResource x:Key="ControlCornerRadius" ResourceKey="PillRadius" />
                        </ItemsControl.Resources>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Command="{Binding Command}" CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CallButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Primary}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Danger}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Critical}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <CheckBox Content="{Binding [Main.HardMode], Source={x:Static app:Loc.Instance}}" IsChecked="{Binding HardMode}" Margin="0,0,40,0" />
                        <CheckBox Content="{Binding [Main.TaxiArrows], Source={x:Static app:Loc.Instance}}" IsChecked="{Binding TaxiArrows}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Transcript -->
            <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" Padding="18,12">
                <StackPanel>
                    <TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Visibility="{Binding ShowStatusDetail, Converter={StaticResource Visible}}" />
                    <ItemsControl ItemsSource="{Binding Transcript}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" FontSize="15" Margin="0,0,0,6">
                                    <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Run Text="{Binding Who, Mode=OneWay}">
                                        <Run.Style>
                                            <Style TargetType="Run">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static host:TranscriptKind.Atc}">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Atc}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static host:TranscriptKind.Pilot}">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Pilot}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Run.Style>
                                    </Run>
                                    <Run Text="{Binding Text, Mode=OneWay}">
                                        <Run.Style>
                                            <Style TargetType="Run">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static host:TranscriptKind.Warning}">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Caution}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static host:TranscriptKind.Event}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Run.Style>
                                    </Run>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ArrowsText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14"
                               Visibility="{Binding ArrowsText, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource Brush.Caution}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding Notice, Converter={StaticResource Visible}}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
