<Window x:Class="OpenSkyAtc.App.Views.PastFlightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:OpenSkyAtc.App"
        Title="{Binding [Main.PastFlights], Source={x:Static app:Loc.Instance}}"
        Width="560" Height="460" MinWidth="420" MinHeight="260" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <StackPanel.Resources>
                <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            </StackPanel.Resources>
            <Button x:Name="OpenButton" Content="{Binding [Past.Open], Source={x:Static app:Loc.Instance}}" Click="Open_Click" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" MinWidth="90" Margin="0,0,6,0" IsEnabled="False" />
            <Button Content="{Binding [Debrief.Close], Source={x:Static app:Loc.Instance}}" IsCancel="True" MinWidth="90" />
        </StackPanel>
        <Grid>
            <ListView x:Name="List" SelectionMode="Single" SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{Binding [Past.Date], Source={x:Static app:Loc.Instance}}" DisplayMemberBinding="{Binding Date}" Width="150" />
                        <GridViewColumn Header="{Binding [Past.Route], Source={x:Static app:Loc.Instance}}" DisplayMemberBinding="{Binding Route}" Width="130" />
                        <GridViewColumn Header="{Binding [Past.Callsign], Source={x:Static app:Loc.Instance}}" DisplayMemberBinding="{Binding Callsign}" Width="110" />
                        <GridViewColumn Header="{Binding [Past.Score], Source={x:Static app:Loc.Instance}}" DisplayMemberBinding="{Binding Score}" Width="70" />
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="Empty" Text="{Binding [Past.None], Source={x:Static app:Loc.Instance}}" TextWrapping="Wrap" Opacity="0.7"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
