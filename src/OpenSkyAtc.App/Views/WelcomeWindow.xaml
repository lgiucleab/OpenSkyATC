<Window x:Class="OpenSkyAtc.App.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:OpenSkyAtc.App"
        Title="{Binding [Welcome.Title], Source={x:Static app:Loc.Instance}}"
        Width="600" Height="520" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20,18">
        <!-- header: logo, title, step -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/logo.png" Width="48" Height="48" Margin="0,0,14,0"
                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding StepText}" Opacity="0.6" VerticalAlignment="Top" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding [Welcome.Heading], Source={x:Static app:Loc.Instance}}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding [Welcome.Sub], Source={x:Static app:Loc.Instance}}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <!-- buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <DockPanel.Resources>
                <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            </DockPanel.Resources>
            <Button DockPanel.Dock="Left" Content="{Binding [Welcome.Skip], Source={x:Static app:Loc.Instance}}" Click="Skip_Click" MinWidth="90" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{Binding [Welcome.Back], Source={x:Static app:Loc.Instance}}" Command="{Binding BackCommand}" MinWidth="90" Margin="0,0,6,0" />
                <Button x:Name="NextButton" Click="Next_Click" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" MinWidth="110">
                    <Button.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding [Welcome.Next], Source={x:Static app:Loc.Instance}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                            <Setter Property="Text" Value="{Binding [Welcome.Done], Source={x:Static app:Loc.Instance}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Foreground="{DynamicResource Brush.Critical}" TextWrapping="Wrap"
                   Visibility="{Binding HasError, Converter={StaticResource Visible}}" />

        <Grid>
            <!-- 1: flight plan -->
            <StackPanel Visibility="{Binding IsPlanStep, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding [Welcome.PlanTitle], Source={x:Static app:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="{Binding [Welcome.PlanText], Source={x:Static app:Loc.Instance}}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12" />
                <RadioButton Content="{Binding [Settings.SourceSimBrief], Source={x:Static app:Loc.Instance}}" IsChecked="{Binding UseSimBrief}" Margin="0,2" />
                <StackPanel Margin="28,4,0,10" IsEnabled="{Binding UseSimBrief}">
                    <TextBlock Style="{StaticResource Label}" Text="{Binding [Settings.SimBriefId], Source={x:Static app:Loc.Instance}}" />
                    <TextBox Text="{Binding SimBriefPilotId, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Width="160" HorizontalAlignment="Left" Margin="0,4" />
                    <TextBlock Text="{Binding [Settings.SimBriefHelp], Source={x:Static app:Loc.Instance}}" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <RadioButton Content="{Binding [Settings.SourcePln], Source={x:Static app:Loc.Instance}}" IsChecked="{Binding UsePln}" Margin="0,2" />
                <DockPanel Margin="28,4,0,0" IsEnabled="{Binding UsePln}">
                    <Button DockPanel.Dock="Right" Content="{Binding [Settings.Browse], Source={x:Static app:Loc.Instance}}" Click="Browse_Click" Margin="6,0,0,0" />
                    <TextBox Text="{Binding PlnPath, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </StackPanel>

            <!-- 2: push-to-talk and voice -->
            <StackPanel Visibility="{Binding IsPttStep, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding [Welcome.PttTitle], Source={x:Static app:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock Text="{Binding [Welcome.PttText], Source={x:Static app:Loc.Instance}}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12" />
                <TextBlock Style="{StaticResource Label}" Text="{Binding [Settings.PttKeyboard], Source={x:Static app:Loc.Instance}}" />
                <TextBox Text="{Binding KeyboardPushToTalk, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,4" />
                <TextBlock Text="{Binding [Settings.PttKeyboardHelp], Source={x:Static app:Loc.Instance}}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,10" />
                <CheckBox Content="{Binding [Welcome.UseAtcKey], Source={x:Static app:Loc.Instance}}" IsChecked="{Binding UseAtcKey}" Margin="0,2" />
                <CheckBox Content="{Binding [Settings.VoiceInput], Source={x:Static app:Loc.Instance}}" IsChecked="{Binding VoiceInput}" Margin="0,6,0,2" />
                <TextBlock Text="{Binding [Welcome.VoiceText], Source={x:Static app:Loc.Instance}}" Opacity="0.7" TextWrapping="Wrap" Margin="28,0,0,0" />
            </StackPanel>

            <!-- 3: first flight -->
            <StackPanel Visibility="{Binding IsFlyStep, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding [Welcome.FlyTitle], Source={x:Static app:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="{Binding [Welcome.Fly1], Source={x:Static app:Loc.Instance}}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding [Welcome.Fly2], Source={x:Static app:Loc.Instance}}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding [Welcome.Fly3], Source={x:Static app:Loc.Instance}}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding [Welcome.Fly4], Source={x:Static app:Loc.Instance}}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="{Binding [Welcome.FlyNote], Source={x:Static app:Loc.Instance}}" TextWrapping="Wrap" Opacity="0.7" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
