<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs a flight (step 13): plan import, sim bridge, brain, voices and taxi arrows behind one class used by
       the WPF app and the console. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSkyAtc.Core\OpenSkyAtc.Core.csproj" />
    <ProjectReference Include="..\OpenSkyAtc.Phraseology\OpenSkyAtc.Phraseology.csproj" />
    <ProjectReference Include="..\OpenSkyAtc.SimConnect\OpenSkyAtc.SimConnect.csproj" />
    <ProjectReference Include="..\OpenSkyAtc.SimBrief\OpenSkyAtc.SimBrief.csproj" />
    <ProjectReference Include="..\OpenSkyAtc.TaxiArrows\OpenSkyAtc.TaxiArrows.csproj" />
    <ProjectReference Include="..\OpenSkyAtc.Voice\OpenSkyAtc.Voice.csproj" />
  </ItemGroup>

  <!-- The owner-filled data files travel with the app. -->
  <ItemGroup>
    <None Include="..\..\data\*.*" Link="data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenSkyAtc.Host.Tests" />
  </ItemGroup>

</Project>
