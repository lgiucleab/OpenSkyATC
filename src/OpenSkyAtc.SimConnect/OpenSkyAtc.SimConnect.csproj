<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <SimConnectManagedDll>$(MSFS2024_SDK)SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</SimConnectManagedDll>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSkyAtc.Core\OpenSkyAtc.Core.csproj" />
  </ItemGroup>

  <!-- Users supply the SimConnect DLLs from their own MSFS 2024 SDK (see LICENSE-EXCEPTION.md).
       Private=false keeps them out of the build output; SimConnectLibrary loads them at runtime. -->
  <ItemGroup>
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(SimConnectManagedDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckSimConnectSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SimConnectManagedDll)')"
           Text="SimConnect not found at '$(SimConnectManagedDll)'. Install the MSFS 2024 SDK and make sure the MSFS2024_SDK environment variable points to it." />
  </Target>

</Project>
