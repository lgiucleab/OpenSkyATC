<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- Where the MSFS 2024 SDK is: the MSFS2024_SDK variable of this shell, else the machine or user value the
       SDK installer wrote (a shell opened before the install does not see it), else the installer's default folder. -->
  <PropertyGroup>
    <_MsfsSdk>$(MSFS2024_SDK)</_MsfsSdk>
    <_MsfsSdk Condition="'$(_MsfsSdk)' == ''">$([MSBuild]::GetRegistryValue('HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Environment', 'MSFS2024_SDK'))</_MsfsSdk>
    <_MsfsSdk Condition="'$(_MsfsSdk)' == ''">$([MSBuild]::GetRegistryValue('HKEY_CURRENT_USER\Environment', 'MSFS2024_SDK'))</_MsfsSdk>
    <_MsfsSdk Condition="'$(_MsfsSdk)' == ''">C:\MSFS 2024 SDK\</_MsfsSdk>
    <SimConnectManagedDll>$([MSBuild]::EnsureTrailingSlash('$(_MsfsSdk)'))SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</SimConnectManagedDll>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSkyAtc.Core\OpenSkyAtc.Core.csproj" />
  </ItemGroup>

  <!-- Users supply the SimConnect DLLs from their own MSFS 2024 SDK (see LICENSE-EXCEPTION.md).
       Private=false keeps them out of the build output; SimConnectLibrary loads them at runtime. -->
  <ItemGroup>
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(SimConnectManagedDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckSimConnectSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(SimConnectManagedDll)')"
           Text="SimConnect not found at '$(SimConnectManagedDll)'. Install the MSFS 2024 SDK (Developer Mode, Help, SDK Installer), or set the MSFS2024_SDK environment variable to the SDK folder." />
  </Target>

</Project>
