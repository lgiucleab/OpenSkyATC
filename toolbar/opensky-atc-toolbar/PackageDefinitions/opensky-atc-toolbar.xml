<?xml version="1.0" encoding="utf-8"?>
<AssetPackage Version="0.1.0">
    <ItemSettings>
        <ContentType>MISC</ContentType>
        <Title>OpenSkyATC Toolbar Panel</Title>
        <Manufacturer/>
        <Creator>OpenSkyATC</Creator>
        <Description>In-sim panel for the OpenSkyATC app: status, frequency, last ATC calls and pilot buttons. GPL-3.0.</Description>
    </ItemSettings>
    <Flags>
        <VisibleInStore>false</VisibleInStore>
        <CanBeReferenced>false</CanBeReferenced>
    </Flags>
    <AssetGroups>
        <!-- Only the panel definition needs the package tool (it becomes InGamePanels/opensky-atc-toolbar.spb);
             tools/assemble_package.py adds html_ui and writes layout.json. -->
        <AssetGroup Name="opensky-atc-toolbar">
            <Type>SPB</Type>
            <Flags>
                <FSXCompatibility>false</FSXCompatibility>
            </Flags>
            <AssetDir>PackageSources\InGamePanels\</AssetDir>
            <OutputDir>InGamePanels\</OutputDir>
        </AssetGroup>
    </AssetGroups>
</AssetPackage>
